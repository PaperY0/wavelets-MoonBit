name = "PaperY0/wavelets"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/PaperY0/wavelets-MoonBit"

license = "MIT"

keywords = [ "wavelet", "dwt", "cwt", "signal-processing", "pywavelets" ]

description = "MoonBit port of PyWavelets: 1D/2D discrete wavelet transforms (DWT/IDWT, multilevel), continuous wavelet transform (CWT), 106 discrete + 10 real continuous wavelets, 9 signal extension modes. Pure computation, no IO."

preferred_target = "wasm"
